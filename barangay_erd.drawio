<?xml version="1.0" encoding="utf-8"?><mxfile host="app.diagrams.net"><diagram name="Barangay ERD" id="erd-current-sql"><mxGraphModel dx="1700" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="erd-title" value="Barangay Portal — Current SQL Schema" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1C1917;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="35" as="geometry" /></mxCell><mxCell id="erd-legend" value="PK = primary key  ·  FK = foreign key  ·  UQ = unique  ·  AI = auto increment  ·  NULL = nullable&lt;br&gt;password_reset_token has account and expiry indexes. account_type/account_id is polymorphic and intentionally has no foreign key." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#57534E;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1250" height="38" as="geometry" /></mxCell><mxCell id="table_user" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;' cellpadding='5' cellspacing='0'&gt;&lt;tr&gt;&lt;th colspan='3' align='left' style='background:#2563EB;color:#ffffff;font-size:14px;padding:8px;'&gt;USER&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;PK, AI&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;user_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;first_name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(100) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;middle_name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;last_name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(100) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;UQ&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;email&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(190) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;password_hash&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(255) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;role&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(50) NOT NULL DEFAULT Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;created_at&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="350" height="266" as="geometry" /></mxCell><mxCell id="table_resident" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;' cellpadding='5' cellspacing='0'&gt;&lt;tr&gt;&lt;th colspan='3' align='left' style='background:#16A34A;color:#ffffff;font-size:14px;padding:8px;'&gt;RESIDENT&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;PK, AI&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;resident_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;first_name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(100) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;middle_name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;last_name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(100) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;UQ&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;email&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(190) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;phone_number&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(30)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;address&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;proof_path&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(500)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;password_hash&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(255) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;is_active&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TINYINT(1) NOT NULL DEFAULT 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;created_at&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="350" height="350" as="geometry" /></mxCell><mxCell id="table_document_type" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;' cellpadding='5' cellspacing='0'&gt;&lt;tr&gt;&lt;th colspan='3' align='left' style='background:#E8871E;color:#ffffff;font-size:14px;padding:8px;'&gt;DOCUMENT_TYPE&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;PK, AI&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;document_type_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;name&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(150) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;is_active&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TINYINT(1) NOT NULL DEFAULT 1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#E8871E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="350" height="126" as="geometry" /></mxCell><mxCell id="table_document_request" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;' cellpadding='5' cellspacing='0'&gt;&lt;tr&gt;&lt;th colspan='3' align='left' style='background:#7C3AED;color:#ffffff;font-size:14px;padding:8px;'&gt;DOCUMENT_REQUEST&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;PK, AI&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;request_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;UQ&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;tracking_code&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(50) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;FK&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;resident_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;FK&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;document_type_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;purpose&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;current_status&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(50) NOT NULL DEFAULT Pending&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;payment_status&lt;/td&gt;&lt;td style='color:#57534e;'&gt;VARCHAR(20) NOT NULL DEFAULT Unpaid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;rejection_reason&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TEXT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&l