34e;'&gt;TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="430" width="350" height="210" as="geometry" /></mxCell><mxCell id="table_request_internal_note" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;' cellpadding='5' cellspacing='0'&gt;&lt;tr&gt;&lt;th colspan='3' align='left' style='background:#7C3AED;color:#ffffff;font-size:14px;padding:8px;'&gt;REQUEST_INTERNAL_NOTE&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;PK, FK&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;request_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;note_text&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TEXT NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;FK, NULL&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;updated_by_user_id&lt;/td&gt;&lt;td style='color:#57534e;'&gt;INT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:55px;color:#475569;font-weight:700;'&gt;&amp;nbsp;&lt;/td&gt;&lt;td style='width:140px;font-weight:600;'&gt;updated_at&lt;/td&gt;&lt;td style='color:#57534e;'&gt;TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="690" width="350" height="154" as="geometry" /></mxCell><mxCell id="table_disclosure" value="&lt;table style='width:100%;border-collapse:collapse;font-size:12px;' cellpadding='5' cellspacing='0'&gt;&lt;tr&gt;&lt;th colspa