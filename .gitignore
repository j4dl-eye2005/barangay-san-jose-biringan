# Secrets — real SMTP credentials, never commit
api/mail_config.php
api/global/
api/local/

# Database credentials stay in the private env file; keep the shared connection code deployable.

# Uploaded files
uploads/proofs/
uploads/disclosures/

# Private storage: keep protection files, ignore stored data
/private_storage/*
!/private_storage/.htaccess
!/private_storage/.gitkeep

# Uploaded profile photos: keep upload protection rules
/uploads/profile-photos/*
!/uploads/profile-photos/.htaccess

# Personal signature image — deploy manually to the server, never commit
assets/julius-signature.png

# One-time admin seeding script (prints a plaintext password)
create_admin.php

# Temporary SMTP test script
test_mail.php
_email_test.php

# Private storage data files
private_storage/admin_ip_allowlist.php

# Runtime secrets and private uploads
.env
.env.*
!*.example
../barangay_portal_private/

# Ignore local database files and dumps while keeping SQL schema/migration sources trackable
/database/*
!/database/*.sql
/database/*dump*.sql
/database/*backup*.sql

# Runtime files
/logs/
/cache/
/tmp/
/vendor/
*.log

# OS/editor clutter
.DS_Store
Thumbs.db
*.swp
*.swo
*~
